{
  "name": "web-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-node-version.js && next dev --turbopack",
    "dev:host": "node scripts/ensure-node-version.js && next dev --turbopack -H 0.0.0.0 -p 3000",
    "docker:dev": "docker compose up",
    "build": "node scripts/ensure-node-version.js && next build",
    "start": "node scripts/ensure-node-version.js && next start",
    "lint": "next lint",
    "test": "tsc tests/region-validation.test.ts lib/region-validation.ts components/optimizer/types.ts --outDir .test-dist --module commonjs --target es2022 --esModuleInterop --skipLibCheck --moduleResolution node --jsx react-jsx && node --test .test-dist/tests/region-validation.test.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
